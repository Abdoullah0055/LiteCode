{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/mobile-programming-lesson-v1.json",
  "title": "Programming mobile lesson (content rights separated from metadata)",
  "type": "object",
  "additionalProperties": true,
  "required": ["id","type","course","module","title","language","difficulty","estimatedDurationMinutes","xp","tags","lessonContent","instructions","starterCode","tests","hints","explanation","prerequisites","source","modifications","editorialFlags","redistributionApproved"],
  "properties": {
    "id": {"type":"string","minLength":4},
    "externalId": {"type":"string"},
    "type": {"enum": ["lesson", "coding_challenge", "multiple_choice", "quiz", "fill_in_the_blank", "debugging_exercise", "project"]},
    "course": {"type":"string"},
    "module": {"type":"string"},
    "title": {"type":"string","minLength":1},
    "language": {"type":"string"},
    "difficulty": {"enum":["beginner","intermediate","advanced"]},
    "difficultySource": {"type":"string"},
    "estimatedDurationMinutes": {"type":"integer","minimum":1},
    "durationSource": {"type":"string"},
    "xp": {"type":"integer","minimum":0},
    "xpSource": {"type":"string"},
    "tags": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "lessonContent": {"type":["string","null"]},
    "instructions": {"type":["string","null"]},
    "starterCode": {"type":["string","null"]},
    "tests": {"type":"array","items": {"type":"object","properties": {"runner":{"type":"string"},"code":{"type":"string"},"portable":{"type":"boolean"},"runOnlyInTrustedSandbox":{"type":"boolean"}}}},
    "test_case": {"type":"array","items":{"type":"object"}},
    "hints": {"type":"array","items":{"type":"string"}},
    "explanation": {"type":["string","null"]},
    "solutions": {"type":"array","items":{"type":"string"}},
    "multipleChoice": {"type":"array","items":{"type":"object","required":["type","question","choices"],"properties":{"type":{"const":"multiple_choice"},"question":{"type":"string"},"choices":{"type":"array","minItems":2,"items":{"type":"object","required":["text","correct"],"properties":{"text":{"type":"string"},"correct":{"type":"boolean"}}}},"needsReview":{"type":"boolean"}}}},
    "project": {"type":["object","null"]},
    "prerequisites": {"type":"array","items":{"type":"string"}},
    "source": {"type":"object","required":["repository","ref","file","url","structureFile","license","attribution"],"properties":{
      "repository":{"const":"freeCodeCamp/freeCodeCamp"},
      "ref":{"type":"string","minLength":7},
      "file":{"type":["string","null"]},
      "url":{"type":["string","null"]},
      "structureFile":{"type":"string"},
      "structureUrl":{"type":"string"},
      "license":{"type":"string"},
      "attribution":{"type":"string"}}},
    "modifications":{"type":"array","items":{"type":"string"}},
    "editorialFlags":{"type":"array","items":{"type":"string"}},
    "redistributionApproved":{"type":"boolean"},
    "orderInBlock":{"type":"integer","minimum":0}
  }
}
